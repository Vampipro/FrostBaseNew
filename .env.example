# Нова база (Neon). Для Vercel використовуй pooled-рядок у DATABASE_URL, direct — у DIRECT_URL
DATABASE_URL="postgresql://USER:PASS@HOST-pooler.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASS@HOST.neon.tech/neondb?sslmode=require"

# Стара база — потрібна ТІЛЬКИ для скрипта міграції (читається, нічого не змінюється)
OLD_DATABASE_URL="postgresql://USER:PASS@OLDHOST.neon.tech/neondb?sslmode=require"

# Секрет для сесій (openssl rand -base64 32)
SESSION_SECRET="change-me"
